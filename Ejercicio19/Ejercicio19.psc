Algoritmo Ejercicio19
    Definir numero, i Como Entero
	
    Escribir "Ingrese un número entero:"
    Leer numero
	
    Escribir ""
    Escribir "===== TABLA DEL ", numero, " ====="
	
    Para i <- 1 Hasta 12 Hacer
        Escribir numero, " x ", i, " = ", numero * i
    FinPara
FinAlgoritmo