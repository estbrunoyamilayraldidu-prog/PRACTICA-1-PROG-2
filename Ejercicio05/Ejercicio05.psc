Algoritmo Ejercicio05
    Definir celsius, fahrenheit Como Real
	
    Escribir "Ingrese la temperatura en Celsius:"
    Leer celsius
	
    fahrenheit <- (9 / 5) * celsius + 32
	
    Escribir ""
    Escribir "===== CONVERSIÓN ====="
    Escribir "Celsius: ", celsius
    Escribir "Fahrenheit: ", fahrenheit
	
    Escribir ""
    Escribir "Ingrese una temperatura en Fahrenheit:"
    Leer fahrenheit
	
    celsius <- (5 / 9) * (fahrenheit - 32)
	
    Escribir "Celsius equivalente: ", celsius
FinAlgoritmo