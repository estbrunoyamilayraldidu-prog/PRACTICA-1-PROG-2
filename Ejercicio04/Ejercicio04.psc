Algoritmo Ejercicio04
    Definir radio, area, perimetro Como Real
	
    Escribir "Ingrese el radio del círculo:"
    Leer radio
	
    area <- PI * radio * radio
    perimetro <- 2 * PI * radio
	
    Escribir ""
    Escribir "===== CÍRCULO ====="
    Escribir "Área: ", area
    Escribir "Perímetro: ", perimetro
FinAlgoritmo